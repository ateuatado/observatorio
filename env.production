#--------------------------------------------------------------------
# OVP — Observatório de Violências Policiais
# Arquivo: .env.production (template — copiar para .env no servidor)
#
# INSTRUÇÃO:
#   cp .env.production .env
#   nano .env  → preencher as variáveis marcadas com <PREENCHER>
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# URL base da aplicação (sem barra final não, com barra final sim)
#--------------------------------------------------------------------
app.baseURL = 'https://<DOMINIO_DO_SERVIDOR>/'
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# BANCO DE DADOS — MySQL de produção
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = <NOME_DO_BANCO>
database.default.username = <USUARIO_DO_BANCO>
database.default.password = <SENHA_DO_BANCO>
database.default.DBDriver = MySQLi
database.default.DBPrefix  =
database.default.port      = 3306
database.default.charset   = utf8mb4
database.default.DBCollat  = utf8mb4_general_ci

#--------------------------------------------------------------------
# SESSÃO
#--------------------------------------------------------------------
session.driver        = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName    = 'ovp_session'
session.expiration    = 7200
session.savePath      = WRITEPATH . 'session'
session.matchIP       = false

#--------------------------------------------------------------------
# SEGURANÇA / CSRF
#--------------------------------------------------------------------
security.csrfProtection = 'cookie'
security.tokenName      = 'csrf_token_ovp'

#--------------------------------------------------------------------
# CACHE (desabilitado por padrão — habilitar se necessário)
#--------------------------------------------------------------------
cache.handler = 'file'

#--------------------------------------------------------------------
# EMAIL (opcional — preencher para recuperação de senha)
#--------------------------------------------------------------------
# email.fromEmail  = no-reply@<DOMINIO_DO_SERVIDOR>
# email.fromName   = OVP-SP
# email.SMTPHost   = smtp.seuservidor.com
# email.SMTPUser   = <USUARIO_SMTP>
# email.SMTPPass   = <SENHA_SMTP>
# email.SMTPPort   = 587
# email.SMTPCrypto = tls
