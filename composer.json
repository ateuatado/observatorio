{
    "require": {
        "codeigniter4/framework": "^4.7",
        "codeigniter4/shield": "^1.3",
        "smalot/pdfparser": "^2.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test":           "vendor/bin/phpunit",
        "test:unit":      "vendor/bin/phpunit --testsuite \"OVP Unit Tests\"",
        "test:feature":   "vendor/bin/phpunit --testsuite \"OVP Feature Tests\"",
        "test:coverage":  "vendor/bin/phpunit --coverage-text"
    }
}
